# ==============================================================================
# Ummu NLP Lab - Environment Configuration Template
# Copy this file to .env and adjust the values for your environment.
# ==============================================================================

# Flask runtime settings
FLASK_ENV=production
FLASK_DEBUG=0
HOST=0.0.0.0
PORT=5000

# Security secrets (IMPORTANT: generate a 64-char random hex in production)
SECRET_KEY=change-this-in-production-use-python-secrets-token-hex-64

# Database location
DATABASE_PATH=nlp_lab.db

# Max request upload size in bytes (15 MB default)
MAX_CONTENT_LENGTH=15728640

# Google OAuth 2.0 Client ID (Optional, leave blank to use built-in auth)
GOOGLE_CLIENT_ID=

# Model In-Memory Cache Size
MODEL_CACHE_SIZE=10

# CORS Whitelist (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
